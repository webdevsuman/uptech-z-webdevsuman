# ==============================================================================
# UPTECH-Z BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your real configuration.

# Application Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI or Local MongoDB)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/uptechz?retryWrites=true&w=majority

# Initial Super Admin Seed Credentials (used by `npm run seed:rbac`)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=YourStrongAdminPassword123!

# Nodemailer SMTP Mail Configuration (e.g. Gmail App Password, SendGrid, Mailtrap)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="Uptech-Z" <noreply@example.com>

# Cloudinary Storage Configuration (For video lectures, course syllabus, and thumbnails)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JSON Web Token (JWT) Secrets (Generate strong random 64-byte hex strings)
JWT_SECRET=your_jwt_access_secret_hex_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_hex_key_here

# Redis Cloud / Local Redis Connection URI (For caching, rate limiting, and session tracking)
REDIS_URL=redis://default:<password>@<redis-host>:<redis-port>

# Stripe Payment Gateway Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret_here
STRIPE_CURRENCY=inr

# Client Web URLs (CORS & Socket.io Allowed Origins)
FRONTEND_BASE_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
